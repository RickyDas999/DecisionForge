# DecisionForge environment variables
#
# Copy to .env and adjust as needed. .env is git-ignored; this file is
# documentation only and must never contain a real key.

# Which model provider to use: mock | anthropic
# Default is "mock" (no credentials, no cost). Leave it as mock for development
# and tests.
MODEL_PROVIDER=mock

# --- Only required when MODEL_PROVIDER=anthropic ---------------------------
# An Anthropic API key and model are mandatory once the anthropic provider is
# selected. Using them makes real API requests that may incur charges.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Optional Anthropic tuning (sensible defaults apply if unset) ---------
# ANTHROPIC_MAX_TOKENS=4096
# ANTHROPIC_TEMPERATURE=
