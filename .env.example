# DecisionForge environment variables
#
# Phase 0 contains no LLM functionality, so nothing here is required yet.
# These keys are placeholders for later phases and are intentionally unused now.

# Anthropic API key (later phases, AnthropicProvider only)
# ANTHROPIC_API_KEY=

# Default model provider: mock | anthropic | local (later phases)
# DECISIONFORGE_MODEL_PROVIDER=mock
